---
/**
 * Componente: ExperienceTimeline.astro
 * Incluye la trayectoria profesional completa y la formación académica.
 */

import { ui } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = ui[lang];

const experiences = [
  {
    period: 'JUN. 2021 – JUL. 2026',
    role: lang === 'es' ? 'Desarrollador de Software Senior' : 'Senior Software Developer',
    company: 'Continental Assist (Remoto)',
    description: lang === 'es'
      ? 'Lideré la integración del CRM con SAP Business One (Service Layer / REST API) para la facturación electrónica en México y Colombia, reduciendo tiempos de respuesta de 2-4 días a 5 minutos mediante colas asíncronas en Redis, batching y consultas SQL optimizadas.'
      : 'Led CRM integration with SAP Business One (Service Layer / REST API) for electronic invoicing in Mexico and Colombia, reducing response times from 2-4 days to 5 minutes using Redis asynchronous queues, batching, and optimized SQL.',
    tags: ['SAP Business One', 'Service Layer', 'Redis Queues', 'SQL', 'PHP', 'Node.js', 'Sentry']
  },
  {
    period: 'MAY. 2018 – MAY. 2021',
    role: lang === 'es' ? 'Analista Programador / Desarrollador Full-Stack' : 'Programmer Analyst / Full-Stack Developer',
    company: 'Palace Resorts — Cancún',
    description: lang === 'es'
    ? 'Arquitecturé y desarrollé módulos clave (auth, products, productions, events) dentro del ecosistema CRM a medida "Clever". Desarrollé aplicaciones web dinámicas y servicios backend utilizando React, Node.js, PHP y Flutter.'
    : 'Architected and developed core modules (auth, products, productions, events) within the custom CRM ecosystem "Clever". Built dynamic web applications and backend services using React, Node.js, PHP, and Flutter.',
    tags: ['React', 'Node.js', 'PHP (Phalcon)', 'Flutter', 'Nginx', 'Git']
  },
  {
    period: 'ENE. 2013 – MAY. 2018',
    role: lang === 'es' ? 'Coordinador de Transportación / Promotor' : 'Transportation Coordinator / Promoter',
    company: 'Captain Hook — Cancún',
    description: lang === 'es'
      ? 'Gestión operativa y logística de traslados turísticos, coordinación de equipos de trabajo y atención a agencias de viajes.'
      : 'Logistics coordination for tourist transfers, team leadership, and travel agency relations.',
    tags: lang === 'es' ? ['Logística', 'Coordinación de Equipos', 'Atención a Clientes'] : ['Logistics', 'Team Leadership', 'Customer Relations']
  }
];

const education = [
  {
    period: '2026 – ACTUALIDAD',
    degree: lang === 'es' ? 'Maestría en Inteligencia Artificial (Cursando)' : 'MSc in Artificial Intelligence (In Progress)',
    institution: 'Universidad Internacional de La Rioja en México (UNIR)'
  },
  {
    period: '2015 – 2019',
    degree: lang === 'es' ? 'Ingeniería en Software' : 'Software Engineering Degree',
    institution: 'Universidad Politécnica de Quintana Roo'
  }
];
---

<section id={lang === 'es' ? "experiencia" : "experiencia-en"} class="scroll-mt-24 space-y-6">
  <h2 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
    <span class="w-3 h-3 rounded-full bg-blue-500 animate-pulse"></span>
    {t['exp.title']}
  </h2>

  <!-- Línea de tiempo -->
  <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 md:ml-6 space-y-8 my-4 transition-colors">
    {experiences.map((exp) => (
      <div class="relative pl-6 md:pl-8 group">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-slate-300 dark:bg-slate-700 border-2 border-slate-50 dark:border-slate-950 transition-all duration-300 ease-out group-hover:bg-blue-500 group-hover:scale-150 group-hover:ring-4 group-hover:ring-blue-500/20"></div>

        <div class="p-5 md:p-6 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 transition-all duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-lg group-hover:shadow-blue-500/5 group-hover:border-blue-500/40 dark:group-hover:border-blue-500/40 space-y-3">
          
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-1">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {exp.role}
            </h3>
            <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 w-fit">
              {exp.period}
            </span>
          </div>

          <p class="text-xs font-semibold text-blue-600 dark:text-blue-400">
            {exp.company}
          </p>

          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {exp.description}
          </p>

          <div class="flex flex-wrap gap-1.5 pt-2">
            {exp.tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/50">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Educación -->
  <div id={lang === 'es' ? "educacion" : "educacion-en"} class="pt-6 space-y-4">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
      {t['edu.title']}
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {education.map((edu) => (
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-1">
          <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400">{edu.period}</span>
          <h4 class="font-bold text-slate-900 dark:text-white text-sm">{edu.degree}</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">{edu.institution}</p>
        </div>
      ))}
    </div>
  </div>
</section>