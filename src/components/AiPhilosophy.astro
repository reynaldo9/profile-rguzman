---
/**
 * Componente: AiPhilosophy.astro
 * Sección de pensamiento técnico con soporte completo para modo Light/Dark.
 */

import { ui } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="my-16 p-6 md:p-8 rounded-2xl bg-slate-100 dark:bg-gradient-to-br dark:from-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm dark:shadow-xl relative overflow-hidden group transition-colors duration-300">
  <!-- Glow suave de fondo que se intensifica en dark mode -->
  <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue-500/10 dark:bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-500/20 dark:group-hover:bg-blue-600/20 transition-all duration-500 pointer-events-none"></div>

  <div class="relative space-y-3">
    <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
      <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
      {lang === 'es' ? 'Pensamiento & Criterio Técnico' : 'Technical Philosophy & AI'}
    </div>

    <h2 class="text-lg md:text-xl font-bold text-slate-900 dark:text-white tracking-tight">
      {lang === 'es' ? 'Gracias por visitar este sitio' : 'Thank you for visiting my site'}
    </h2>

    <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      {t['ai.philosophy']}
    </p>
  </div>
</section>