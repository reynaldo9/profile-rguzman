---
/**
 * Componente: LanguageToggle.astro
 * Descripción: Botón de conmutación de idioma con indicador visual activo mediante CSS y Tailwind.
 */
---

<!-- 
  El botón incluye 'btn-lang-toggle' para ser identificado por el script
  y clases hover para dar retroalimentación visual al pasar el cursor.
-->
<button
  type="button"
  id="lang-toggle-btn"
  class="btn-lang-toggle inline-flex items-center gap-1 p-1 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/80 text-slate-600 dark:text-slate-400 hover:border-blue-500/50 transition-all cursor-pointer select-none"
  aria-label="Toggle Language"
>
  <!-- Etiqueta ES -->
  <span 
    id="lang-es-indicator"
    class="lang-es px-2 py-1 rounded-md transition-all duration-200 bg-blue-600 text-white shadow-xs"
  >
    ES
  </span>

  <span class="text-slate-400 dark:text-slate-600 text-[10px] font-normal">/</span>

  <!-- Etiqueta EN -->
  <span 
    id="lang-en-indicator"
    class="lang-en px-2 py-1 rounded-md transition-all duration-200 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
  >
    EN
  </span>
</button>