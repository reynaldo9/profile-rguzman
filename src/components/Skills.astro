---
/**
 * Componente: Skills.astro
 * Descripción: Clasificación completa de tus lenguajes, frameworks, BD y herramientas de IA.
 */

import { ui } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = ui[lang];

const skillCategories = [
  {
    title: t['skills.frontend'],
    skills: ['React', 'Qwik', 'Vue', 'Nuxt', 'Next.js', 'TypeScript', 'JavaScript', 'HTML5/CSS3', 'Tailwind', 'Material UI', 'Bootstrap', 'Sass']
  },
  {
    title: t['skills.backend'],
    skills: ['Node.js', 'PHP (Phalcon, Laravel)', 'Python', 'Java', 'C++', 'C#']
  },
  {
    title: t['skills.databases'],
    skills: ['MySQL', 'PostgreSQL', 'MariaDB', 'SQLite', 'Redis', 'AWS', 'Google Cloud', 'DigitalOcean', 'Linux (Ubuntu, Debian, CentOS)', 'Nginx', 'Apache']
  },
  {
    title: t['skills.devsecops'],
    skills: ['SAP Business One (Service Layer, Batch)', 'OWASP', 'JWT', 'OAuth2', 'RBAC', 'HTTPS/TLS', 'CORS', 'Rate Limiting', 'Sentry', 'Playwright', 'Mocha', 'Git']
  },
  {
    title: t['skills.ai'],
    skills: ['Claude API', 'Gemini API', 'Model Context Protocol (MCP)', t['skills.ai_refactor'], 'Prompt Engineering']  },
  {
    title: t['skills.mobile'],
    skills: ['Android', 'Flutter']
  }
];
---

<section id={lang === 'es' ? "habilidades" : "habilidades-en"} class="scroll-mt-24 space-y-6">
  <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
    {t['skills.title']}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {skillCategories.map((cat) => (
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h3 class="text-sm font-semibold text-blue-600 dark:text-blue-400 mb-3">{cat.title}</h3>
        <div class="flex flex-wrap gap-1.5">
          {cat.skills.map((skill) => (
            <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>